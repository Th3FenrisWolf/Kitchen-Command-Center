    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.58.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="RobotsTxtCore" Version="3.0.0" />
    <PackageVersion Include="SimpleMvcSitemap" Version="4.0.1" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.1.118" />
    <PackageVersion Include="TUnit" Version="1.27.0" />
    <PackageVersion Include="TUnit.Playwright" Version="1.27.0" />
    <PackageVersion Include="Umbraco.Cms" Version="17.7.0" />

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Anthropic" Version="13.4.0" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="RobotsTxtCore" Version="3.0.0" />
    <PackageVersion Include="SimpleMvcSitemap" Version="4.0.1" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.2.0" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.1.118" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <PackageVersion Include="TUnit" Version="1.80.0" />
    <PackageVersion Include="TUnit.Playwright" Version="1.80.0" />
    <!-- On 17.8.0 a recipe published from a draft answered 404 in half of the E2E runs, and never on 17.7.2. -->
    <PackageVersion Include="Umbraco.Cms" Version="17.7.2" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="17.7.2" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore" Version="17.7.2" />
    <PackageVersion Include="uSync" Version="17.6.1" />
    <PackageVersion Include="Vite.AspNetCore" Version="2.4.1" />
  </ItemGroup>
</Project>

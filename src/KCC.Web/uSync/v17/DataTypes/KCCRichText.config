<DataType Key="b131e21e-12ce-8e1e-97b9-438050e12ced" Alias="KCC Rich Text" Level="1">
  <Info>
    <Name>KCC Rich Text</Name>
    <EditorAlias>Umbraco.RichText</EditorAlias>
    <EditorUIAlias>Umb.PropertyEditorUi.Tiptap</EditorUIAlias>
  </Info>
  <Config><![CDATA[{
  "extensions": [
    "Umb.Tiptap.RichTextEssentials",
    "Umb.Tiptap.Heading",
    "Umb.Tiptap.Italic",

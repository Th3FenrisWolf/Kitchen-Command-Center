@using KCC.Web.Features.Pages.Home

@model StackerSection

<div class="kcc-secname"><h2 class="kcc-section" v-pre>@Model.Heading</h2></div>

<div class="grid items-start gap-x-7 gap-y-rule-1.5 lg:grid-cols-2">
  @if (Model.HasSheet)
  {
    <div class="kcc-slip kcc-tear-@Model.Tear w-full lg:sticky lg:top-[calc(2rem_+_var(--pad-offset,0px))] lg:transition-[top]">
      <div class="kcc-torn">
        <div class="kcc-sheet">
          <KccWashes wash-key="home-stacker:@Model.Key" size="reading" />
          <div class="grid gap-y-rule-1">
            @if (!string.IsNullOrWhiteSpace(Model.BodyHtml))
            {
              <div class="kcc-body kcc-prose" v-pre>@Html.Raw(Model.BodyHtml)</div>
            }

            @if (Model.Image is { } image)
            {
              <img class="block w-full object-cover" src="@image.Url" alt="@image.Alt" loading="lazy" />
            }
          </div>
        </div>
      </div>
      <span class="kcc-blank" aria-hidden="true"><span></span></span>
    </div>
  }

  <Stacker :cards="@Vue.Prop(Model.Cards)" />
</div>

@using KCC.Web.Features.Pages.Error

@model ErrorViewModel

@* Razor cannot use the KccSheet.vue primitive (not a *.Component.vue, so not globally registered); it
   hand-writes the same Structure from the global kit classes in Kit.css. *@
<div class="kcc-slip kcc-tear-4 mx-auto mt-rule-2 w-full max-w-2xl">
  <div class="kcc-torn">
    <div class="kcc-sheet" style="--pad: 48px">
      <KccWashes wash-key="error" size="reading" chosen="red" />
      <p class="kcc-kick kcc-num">@Model.StatusCode</p>
      @* App.vue compiles this markup as a Vue template; v-pre keeps editors' {{ }} and v-* text from running. *@
      <h1 class="kcc-display mt-rule-1" v-pre>@Model.Heading</h1>
      <div class="kcc-body mt-rule-1" v-pre>@Html.Raw(Model.Body)</div>
    </div>
  </div>
  <span class="kcc-label"><i class="fa-duotone fa-triangle-exclamation" aria-hidden="true"></i>Error</span>
  <span class="kcc-blank" aria-hidden="true"><span></span></span>
</div>

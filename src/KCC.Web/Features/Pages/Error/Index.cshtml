@using KCC.Web.Features.Pages.Error

@model ErrorViewModel

@* Razor cannot use the Sheet.vue primitive (not a *.Component.vue, so not globally registered); it
   composes the same look from the global kit classes plus the data-ink opt-in. *@
<section class="my-10 grid place-items-center">
    <div class="sk-sheet sk-sheet--lg sk-fold max-w-2xl text-center" data-ink="sheet">
        <h1 class="sk-display mb-5 text-4.5xl">@Model.Heading</h1>
        <div class="sk-body">@Html.Raw(Model.Body)</div>
    </div>
</section>

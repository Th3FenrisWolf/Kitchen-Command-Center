@using KCC.Web.Features.Pages.Error

@model ErrorViewModel

@* Razor cannot use the Sheet.vue primitive (not a *.Component.vue, so not globally registered); it
   hand-writes the same Structure from the global kit classes in Kit.css. *@
<div class="kcc-slip kcc-tear-4 mx-auto mt-12 max-w-2xl">
  <div class="kcc-torn">
    <div class="kcc-sheet" style="--pad: 48px">
      <span class="kcc-wash" style="--c: var(--color-red); --x: 85%; --y: 90%; --w: 55%; --h: 50%" aria-hidden="true"></span>
      <p class="kcc-kick">Error</p>
      <h1 class="kcc-h3 mt-6">@Model.Heading</h1>
      <div class="kcc-body mt-6">@Html.Raw(Model.Body)</div>
    </div>
  </div>
  <span class="kcc-label"><i class="fa-duotone fa-triangle-exclamation" aria-hidden="true"></i>Error</span>
</div>

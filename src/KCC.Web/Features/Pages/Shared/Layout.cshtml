@using System.Globalization
@using KCC.Web.Features.Bloom
@using KCC.Web.Features.Components.Footer
@using KCC.Web.Features.Components.Header
@using KCC.Web.Features.Dictionary
@using KCC.Web.Features.Ramp
@using Umbraco.Cms.Core.Web

@inject IWebHostEnvironment Env
@inject VueSsrService VueSsrService
@inject IUmbracoContextAccessor UmbracoContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject IResourceStringProvider ResourceStrings
@inject Vite.AspNetCore.IViteManifest ViteManifest
@inject Vite.AspNetCore.IViteDevServerStatus ViteDevServer
@inject TimeProvider Clock

@model BasePageViewModel

@{
    // Default JSON encoder escapes <, >, & to \uXXXX so this is safe inside <script>.
    var apiConfigJson = System.Text.Json.JsonSerializer.Serialize(
        new
        {
            antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken,
            strings = new
            {
                unexpectedError = ResourceStrings.GetOrDefault("Api.UnexpectedError"),
                requestFailed = ResourceStrings.GetOrDefault("Api.RequestFailed"),
            },
        },
        new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
        });
    var isPreview = UmbracoContextAccessor.TryGetUmbracoContext(out var umbracoContext) && umbracoContext.InPreviewMode;
    var savedRamp = RampCookie.Read(Context);
    var visit = VisitClock.Resolve(Context, Clock);
    var washElapsed = visit.Elapsed.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture);

    var header = await Component.InvokeAsync(typeof(HeaderViewComponent));
    var body = RenderBody();
    var footer = await Component.InvokeAsync(typeof(FooterViewComponent));
    var app = await VueSsrService.RenderVueSsrAsync(
        header,
        body,
        footer,
        BloomInputs.For(Context, visit),
        isPreview,
        Context.RequestAborted);
}

<!DOCTYPE html>
<html lang="en" data-theme="@(savedRamp ?? "light")" style="--wash-elapsed: @(washElapsed)s">

<head>
  <partial name="~/Features/Pages/Shared/Partials/Metadata.cshtml" />

  <script type="application/json" id="api-config">@Html.Raw(apiConfigJson)</script>

  @* Preload the brand fonts so they're fetched at high priority and ready by first paint.
     Hazelnut, APCasual and Sono are font-display: swap, so without this the page first paints in a
     fallback font and reflows when they load (the layout shift we were chasing). Fonts fetch
     in CORS mode, so `crossorigin` is required for the preloaded file to be reused. The names
     are content-hashed, so they come from the build manifest.

     Development serves the fonts off the Vite dev server in a couple of milliseconds, where a
     preload saves nothing and browsers that decline to reuse it warn once per font per load. *@
  @if (!Env.IsDevelopment() && ViteManifest["Features/Styles/Main.css"] is { Assets: var fontAssets } && fontAssets is not null)
  {
    foreach (var asset in fontAssets)
    {
      if (asset.Contains("HazelnutMilkTeaRegular") || asset.Contains("AmericanPurposeCasualRegular") || (asset.Contains("Sono-Regular-latin") && !asset.Contains("latin-ext")))
      {
        <link rel="preload" as="font" type="font/woff2" crossorigin href="~/@asset" />
      }
    }
  }

  @* The wash textures are cached files the stylesheet only names, so the browser would find them after the CSS
     has parsed and a bloomed sheet would first paint bare. Masks fetch in CORS mode, so the preload needs
     `crossorigin` to be reused, as the fonts do. *@
  @if (!Env.IsDevelopment() && ViteManifest["Features/Styles/Main.css"] is { Assets: var washTextures } && washTextures is not null)
  {
    foreach (var asset in washTextures)
    {
      if (asset.StartsWith("assets/wash-") && asset.EndsWith(".png"))
      {
        <link rel="preload" as="image" type="image/png" crossorigin href="~/@asset" />
      }
    }
  }

  @* The ramp must be known before the first paint or dark-ramp users flash the light default. A signed-in
     member's saved ramp is rendered above. Without one, the script follows the OS preference. The attribute is
     pre-set to light in the markup (the identity leads light), so a visitor without JavaScript gets a consistent
     light page and the script only ever overwrites it. *@
  @if (savedRamp is null)
  {
    <script>
      document.documentElement.setAttribute(
        'data-theme',
        window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
  }

  <link rel="stylesheet" vite-href="/Features/Styles/Main.css" asp-append-version="true" />

  @* SFC <style> blocks are extracted into chunk CSS assets that the script tag helper never links.
     A stylesheet link on the script entry makes Vite.AspNetCore emit every CSS file in that entry's
     import graph. Dev-server mode is excluded: the link would resolve to the raw TS module, and the
     Vite client injects component styles itself. *@
  @if (!ViteDevServer.IsEnabled)
  {
    <link rel="stylesheet" vite-href="/Features/Main.ts" asp-append-version="true" />
  }

  <style id="kcc-bloom-schedule">@Html.Raw(app.Schedule)</style>

</head>

<body>
  @* Filter defs for the kit's tiles. Static so server-rendered tiles are filtered before hydration. *@
  <svg id="kcc-wax-defs" width="0" height="0" aria-hidden="true" style="position:absolute">
    <defs>
      <filter id="kcc-wax-flat" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" seed="17" result="w"></feTurbulence>
        <feComposite in="SourceGraphic" in2="w" operator="arithmetic" k1="0.48" k2="0.72" k3="0" k4="0"></feComposite>
      </filter>
    </defs>
  </svg>

  @app

  <script type="module" vite-src="/Features/Main.ts" asp-append-version="true"></script>
</body>

</html>

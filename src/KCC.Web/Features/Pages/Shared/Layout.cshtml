@using KCC.Web.Features.Components.Footer
@using KCC.Web.Features.Components.Header
@using Kentico.Content.Web.Mvc.Routing
@using Microsoft.AspNetCore.Hosting

@inject IWebHostEnvironment Env
@inject VueSsrService VueSsrService
@inject IPreferredLanguageRetriever PreferredLanguageRetriever
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject KCC.ResourceStrings.Data.IResourceStringInfoProvider ResourceStrings
@inject Vite.AspNetCore.IViteManifest ViteManifest
@inject Vite.AspNetCore.IViteDevServerStatus ViteDevServer

@model BasePageViewModel

@{
    // Default JSON encoder escapes <, >, & to \uXXXX so this is safe inside <script>.
    var apiConfigJson = System.Text.Json.JsonSerializer.Serialize(
        new
        {
            antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken,
            strings = new
            {
                unexpectedError = ResourceStrings.GetOrDefault("Api.UnexpectedError"),
                requestFailed = ResourceStrings.GetOrDefault("Api.RequestFailed"),
            },
        },
        new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
        });
}

<!DOCTYPE html>
<html lang="@PreferredLanguageRetriever.Get()">

<head>
  <partial name="~/Features/Pages/Shared/Partials/Metadata.cshtml" />

  <script type="application/json" id="api-config">@Html.Raw(apiConfigJson)</script>

  @* Preload the brand fonts so they're fetched at high priority and ready by first paint.
     Hazelnut/APCasual are font-display: swap, so without this the page first paints in a
     fallback font and reflows when they load (the layout shift we were chasing). Fonts fetch
     in CORS mode, so `crossorigin` is required for the preloaded file to be reused. The names
     are content-hashed, so they come from the build manifest.

     Development serves the fonts off the Vite dev server in a couple of milliseconds, where a
     preload saves nothing and browsers that decline to reuse it warn once per font per load. *@
  @if (!Env.IsDevelopment() && ViteManifest["Features/Styles/Main.css"] is { Assets: var fontAssets } && fontAssets is not null)
  {
    foreach (var asset in fontAssets)
    {
      if (asset.Contains("HazelnutMilkTeaRegular") || asset.Contains("HazelnutMilkTeaBold-") || asset.Contains("AmericanPurposeCasualRegular"))
      {
        <link rel="preload" as="font" type="font/woff2" crossorigin href="~/@asset" />
      }
    }
  }

  @* The ramp must be known before the first paint or light-ramp users flash the dark default. Stored choice →
     OS preference → dark (the design's default). Phase 2 adds the toggle that writes the stored choice. *@
  <script>
    (function () {
      var stored = null;
      try {
        stored = localStorage.getItem('kcc-theme');
      } catch (e) {
        /* storage blocked: fall through to the OS preference rather than losing it too */
      }
      var theme = stored === 'light' || stored === 'dark'
        ? stored
        : window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>

  <link rel="stylesheet" vite-href="/Features/Styles/Main.css" asp-append-version="true" />

  @* SFC <style> blocks are extracted into chunk CSS assets that the script tag helper never links.
     A stylesheet link on the script entry makes Vite.AspNetCore emit every CSS file in that entry's
     import graph. Dev-server mode is excluded: the link would resolve to the raw TS module, and the
     Vite client injects component styles itself. *@
  @if (!ViteDevServer.IsEnabled)
  {
    <link rel="stylesheet" vite-href="/Features/Main.ts" asp-append-version="true" />
  }

  <page-builder-mount-preload />
  <page-builder-styles />
</head>

<body>
  @* Filter defs for the drawn kit's washes. Static so server-rendered washes are filtered before hydration. *@
  <svg id="kcc-ink-defs" width="0" height="0" aria-hidden="true" style="position:absolute">
    <defs>
      <filter id="kcc-wash" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.012 0.016" numOctaves="3" seed="5" result="n"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="26" xChannelSelector="R" yChannelSelector="G" result="d"></feDisplacementMap>
        <feGaussianBlur in="d" stdDeviation="1.6"></feGaussianBlur>
      </filter>
      <filter id="kcc-soft" x="-25%" y="-25%" width="150%" height="150%"><feGaussianBlur stdDeviation="1.4"></feGaussianBlur></filter>
      <filter id="kcc-soft2" x="-35%" y="-35%" width="170%" height="170%"><feGaussianBlur stdDeviation="4.5"></feGaussianBlur></filter>
    </defs>
  </svg>

  @await VueSsrService.RenderVueSsrAsync(
    await Component.InvokeAsync(typeof(HeaderViewComponent)),
    RenderBody(),
    await Component.InvokeAsync(typeof(FooterViewComponent)),
    Context.IsPreview() || Context.IsPageBuilder(),
    Context.RequestAborted
  )

  <script type="module" vite-src="/Features/Main.ts" asp-append-version="true"></script>

  <page-builder-mount-script />
  <resource-string-editor />
  <page-builder-scripts />
</body>

</html>

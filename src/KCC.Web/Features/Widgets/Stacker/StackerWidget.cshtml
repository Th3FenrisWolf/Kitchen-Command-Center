@using KCC.Web.Features.Widgets.Stacker

@model StackerWidgetViewModel

<div class="grid items-start gap-x-7 gap-y-9 lg:grid-cols-2">
  <div class="grid gap-4 lg:sticky lg:top-8">
    <h2 class="kcc-h3">@Model.Heading</h2>

    <div class="kcc-body">
      @Html.Raw(Html.Kentico().ResolveRichText(Model.Body))
    </div>

    @if (Model.Image is not null)
    {
      <img class="block w-full object-cover" src="@Model.Image.Asset.Url.StripTilde()" alt="@Model.Image.AltText" />
    }
  </div>

  <Stacker data-vue-mount :cards="@Vue.Prop(Model.Cards)" />
</div>

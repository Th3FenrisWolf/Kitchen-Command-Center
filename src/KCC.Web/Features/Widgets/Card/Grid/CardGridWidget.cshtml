@using KCC.Web.Features.Widgets.Card.Grid
@using KCC.Web.Features.Models.Common

@model CardGridWidgetViewModel

@if (Model.Cards.Any())
{
  var i = 0;

  <div class="grid gap-x-7 gap-y-9 lg:grid-cols-2 @Model.Properties.GetMarginClasses()" data-vue-mount>
    @foreach (var card in Model.Cards)
    {
      <Card key="@card.Heading" card-color="@card.BackgroundColor" :tear="@((i % 6) + 1)">
        <div>
          <h2 class="kcc-h4">@card.Heading</h2>
          <h3 class="kcc-body text-ink-soft">@card.SubHeading</h3>
        </div>

        @if (!string.IsNullOrEmpty(card.Body))
        {
          <template #drawer>
            <p class="kcc-body">@card.Body</p>

            @if (card.Link.FirstOrDefault()?.MapToPageLink() is PageLink link)
            {
              <UnderlineLink href="@link.Url">
                @link.DisplayText
              </UnderlineLink>
            }
          </template>
        }
      </Card>

      i++;
    }
  </div>
}
else
{
  <p>@WidgetConstants.ConfigHeading</p>
  <p>@WidgetConstants.ConfigSubHeading</p>
}

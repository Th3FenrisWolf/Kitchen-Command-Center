@using KCC.Web.Features.Widgets.Button;
@using Kentico.Content.Web.Mvc;

@model ComponentViewModel<ButtonWidgetProperties>

@{
    var isEditMode = Context.Kentico().PageBuilder().EditMode;
    var variant = Model.Properties.Variant switch
    {
        // `paper` is gone from the kit; the secondary option now draws the same hairline pill as Outlined.
        "Secondary" => "ghost",
        "Outlined" => "ghost",
        "Tertiary" => "text",
        _ => "marker",
    };
    var isLarge = Model.Properties.Size != "Small";
    var modifiers = new List<string>();
    if (variant != "marker")
    {
        modifiers.Add($"kcc-btn--{variant}");
    }
    if (isLarge)
    {
        modifiers.Add("kcc-btn--lg");
    }
    var buttonStyles = string.Join(" ", modifiers);
}

<div class="flex @Model.Properties.Alignment @Model.Properties.GetMarginClasses()">
    <button-link href="@Model.Properties.ButtonUrl" target="@Model.Properties.ButtonTarget" class="@buttonStyles @(isEditMode ? "cursor-text" : "cursor-pointer")">
        @if (isEditMode)
        {
            Html.Kentico().RichTextEditor(nameof(Model.Properties.ButtonText));
        }
        else
        {
            @Html.Raw(Html.Kentico().ResolveRichText(@Model.Properties.ButtonText))
        }
    </button-link>
</div>

{
  "name": "kitchen-command-center",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ssr": "vite build --mode ssr",
    "build:all": "vite build && vite build --mode ssr",
    "dev:static": "vite",
    "dev:ssr": "node Features/Ssr/Server.js",
    "dev:all": "concurrently -k -n \"VITE,SSR\" -c \"cyan,green\" \"pnpm dev:static\" \"pnpm dev:ssr\"",
    "test": "vitest run",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write Features/ \"../../tests/KCC.ViteTests/**/*.{ts,vue}\"",
    "tears": "node --experimental-strip-types Features/Torn/generateTears.ts",
    "washes": "node --experimental-strip-types Features/Bloom/generateWashes.ts"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-pro": "catalog:",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@tsconfig/node26": "^26.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.6",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "postcss": "catalog:",
    "prettier": "^3.9.10",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "catalog:",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  }
}
